# Copy this file to .env and fill in your real Oracle server details.

# --- Oracle connection -------------------------------------------------
# Option A: give host/port/service name separately
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=XEPDB1

# Option B: OR set a full connect string / TNS alias / Oracle Cloud
# wallet alias instead (this takes priority over Option A if set)
# ORACLE_CONNECT_STRING=localhost:1521/XEPDB1
# ORACLE_CONNECT_STRING=mydb_high   # e.g. Oracle Autonomous DB wallet alias

ORACLE_USER=pearls_app
ORACLE_PASSWORD=change-me

ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=10

# --- App -----------------------------------------------------------------
PORT=3000
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:3000
