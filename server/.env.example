# Railway's PostgreSQL add-on injects DATABASE_URL automatically — you
# usually don't need to set anything here except JWT_SECRET when deployed.
DATABASE_URL=postgresql://user:password@host:5432/railway

# Local dev fallback (used only if DATABASE_URL is not set):
PGHOST=localhost
PGPORT=5432
PGDATABASE=pearls_test
PGUSER=postgres
PGPASSWORD=change-me

PORT=3000
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:3000
